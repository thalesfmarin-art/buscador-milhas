    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "List award routes"
   },
   "description": "Lists a page of tracked routes that can be searched. Provide exactly two of mileage_program, origin, and destination. Results are ordered by origin, destination, then mileage program. To retrieve all routes, use limit=100 and follow next_offset with the same filters until has_more=false. Restart at offset=0 if the catalog changes while paging. Tracked routes do not establish nonstop service or award availability; verify those with get_flights.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "destination": {
      "description": "The destination airport to list routes for. (2 of 3 required)",
      "type": [
       "string",
       "null"
      ]
     },
     "limit": {
      "description": "Routes per page, up to 100. Omitted or 0 defaults to 25. Use 100 when listing all routes.",
      "maximum": 100,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "mileage_program": {
      "description": "The mileage program to list routes for. (2 of 3 required)",
      "type": [
       "string",
       "null"
      ]
     },
     "offset": {
      "description": "Number of matching routes to skip. Use next_offset from the previous page with the same filters.",
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "origin": {
      "description": "The origin airport to list routes for. (2 of 3 required)",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
