   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Search cached award flights"
   },
   "description": "Retrieves reward flight availability between the given airports that departs within the given date range. Anonymous access includes only public flights departing today through 60 days from today (UTC calendar dates).",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "aircraft": {
      "description": "Desired aircraft type(s) (e.g. 737, 320) (optional)",
      "items": {
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "alliances": {
      "description": "Desired airline alliance(s) (optional). Filters to flights whose operating carrier belongs to one of the given alliances.",
      "items": {
       "enum": [
        "Star Alliance",
        "Oneworld",
        "SkyTeam"
       ],
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "arrival_hour": {
      "additionalProperties": false,
      "description": "Desired local arrival hours, inclusive to the minute (optional). An arrival after midnight on a later date than departure and before 04:00 counts as late night on the travel day (00:41 is treated as 24:41), so before excludes it and after keeps it. Later next-day arrivals, such as overnight flights landing in the morning, use their own clock time.",
      "properties": {
       "after": {
        "description": "Desired arrival hour on or after, i.e. 6 means 06:00 AM (optional)",
        "maximum": 23,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       },
       "before": {
        "description": "Desired arrival hour on or before, i.e. 20 means 8:00 PM (optional)",
        "maximum": 23,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "before",
       "after"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "cabin": {
      "description": "Desired cabin class of travel (optional)",
      "enum": [
       null,
       "economy",
       "premium",
       "business",
       "first"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "departure_hour": {
      "additionalProperties": false,
      "description": "Desired departure hours (optional)",
      "properties": {
       "after": {
        "description": "Desired departure hour on or after, i.e. 12 means 12:00 PM (optional)",
        "maximum": 23,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       },
       "before": {
        "description": "Desired departure hour on or before, i.e. 14 means 2:00 PM (optional)",
        "maximum": 23,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "before",
       "after"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "destinations": {
      "description": "Arrival/destination IATA airport codes (e.g LHR or CDG)",
      "items": {
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "end_date": {
      "description": "End date in YYYY-MM-DD format, same as start date if only one day. At most 60 days after start_date; split wider ranges into multiple searches.",
      "type": "string"
     },
     "max_fees": {
      "description": "Maximum number of fees to spend in USD cents (i.e. $400 = 40000) (optional, 0 (unlimited) is the default)",
      "type": [
       "integer",
       "null"
      ]
     },
     "max_points": {
      "description": "Maximum number of points to spend (optional, 0 (unlimited) is the default)",
      "type": [
       "integer",
       "null"
      ]
     },
     "max_results": {
      "description": "Maximum number of results to return (optional)",
      "maximum": 50,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "max_stops": {
      "description": "Maximum number of stops (optional, 0 (direct only) is the default)",
      "type": [
       "integer",
       "null"
      ]
     },
     "min_cabin_pct": {
      "description": "Minimum share of the journey's distance that must be in the selected cabin, 1-100. 100, or omitting the field, means every segment in the selected cabin (the default). Only set a value below 100 when the user explicitly accepts mixed-cabin itineraries (e.g. 75 allows up to a quarter of the journey in a lower cabin). Itineraries admitted by this tolerance carry mixed_cabin_pct (the share of distance below the cabin) and a mixed_cabin warning; always tell the user those itineraries include segments in a lower cabin. NOTE: 0 here means unset/default, not 'accept anything'. Use 1 for the loosest tolerance. (optional, Pro subscription required)",
      "maximum": 100,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "min_seats": {
      "description": "Minimum number of seats available, not supported by all mileage programs(optional, 1 is the default)",
      "type": [
       "integer",
       "null"
      ]
     },
     "operating_carriers": {
      "description": "Desired two-letter IATA operating carrier code(s) (e.g. UA for United Airlines) (optional)",
      "items": {
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "origins": {
      "description": "Departure/origin IATA airport codes (e.g LHR or LAX)",
      "items": {
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "programs": {
      "description": "Desired mileage program(s) (optional, do not specify unless the user asks for them)",
      "items": {
       "enum": [
        "aeromexico",
        "aeroplan",
        "alaska",
        "american",
        "asiamiles",
        "azul",
        "british",
        "copa",
        "delta",
        "emirates",
        "ethiopian",
        "etihad",
        "eurobonus",
        "eva",
        "finnair",
        "flyingblue",
        "frontier",
        "iberia",
        "jal",
        "jetblue",
        "latam",
        "lifemiles",
        "livelo",
        "lufthansa",
        "porter",
        "qantas",
        "qatar",
        "saudia",
        "singapore",
        "smiles",
        "spirit",
        "turkish",
        "united",
        "velocity",
        "virginatlantic"
       ],
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "sort": {
      "description": "Sort results by field (optional, default is mileage cost)",
      "enum": [
       null,
       "mileage_cost",
       "departure_time",
       "duration_minutes",
       "taxes",
       "stops"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "sort_direction": {
      "description": "Sort direction (optional, default is ascending)",
      "enum": [
       null,
       "asc",
       "desc"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "start_date": {
      "description": "Start date in YYYY-MM-DD format",
      "type": "string"
     },
     "transfer_partners": {
      "description": "Desired transferable-points program(s) (optional). Filters to mileage programs that are transfer partners of the given card program(s) — e.g. only show awards bookable by transferring from Amex Membership Rewards.",
      "items": {
       "enum": [
        "amexau",
        "amexca",
        "amexus",
        "bilt",
        "capitalone",
        "chaseus",
        "citius",
        "esfera",
        "livelo",
        "rove",
        "usbank",
        "wellsfargo"
       ],
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     }
    },
    "required": [
     "origins",
     "destinations",
     "start_date",
     "end_date"
    ],
    "type": "object"
   },
