   "description": "Looks up airport codes when you don't already know them. Match airports by free-text query (airport name, city, IATA or ICAO code) and/or by country (name or ISO code), and surface seats.aero meta airport codes — metro-area and regional groupings such as NYC, LON, or EUR that expand to several airports. Use this before get_flights or create_alert whenever the user names a place, city, region, or niche airport rather than a code you are sure of.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "description": "Restrict results to a single country, given as a name ('Japan') or ISO 3166-1 alpha-2 code ('JP'). Optional if a query is given.",
      "type": [
       "string",
       "null"
      ]
     },
     "limit": {
      "description": "Optional maximum number of airport results to return. Defaults to 20; capped at 100.",
      "maximum": 100,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "order_by": {
      "description": "Optional ordering for the airport results. 'relevance' (default) ranks best matches and busiest airports first; 'traffic' sorts by average weekly flights; 'name', 'iata', and 'country' sort alphabetically.",
      "enum": [
       null,
       "relevance",
       "traffic",
       "name",
       "iata",
       "country"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "query": {
      "description": "Free-text to match against airport IATA/ICAO code, name, city, or address, and against meta airport codes and their labels (e.g. 'Tokyo', 'Heathrow', 'Southeast Asia'). Optional if a country is given.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
