   "description": "Lists the transfer partners and base ratios for a specific mileage program.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "mileage_program": {
      "description": "The mileage program to retrieve transfer partners for.",
      "enum": [
       "aeromexico",
       "aeroplan",
       "alaska",
       "american",
       "asiamiles",
       "azul",
